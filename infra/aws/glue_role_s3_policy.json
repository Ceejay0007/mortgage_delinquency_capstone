{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListProjectBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::conrad-mortgage-capstone-2026"
    },
    {
      "Sid": "ReadGlueScripts",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::conrad-mortgage-capstone-2026/scripts/*"
    },
    {
      "Sid": "ReadBronze",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::conrad-mortgage-capstone-2026/bronze/*"
    },
    {
      "Sid": "ReadWriteSilver",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::conrad-mortgage-capstone-2026/silver/*"
    }
  ]
}